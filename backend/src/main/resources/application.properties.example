spring.application.name=backend

# Server
server.port=${PORT:8080}

# Database
spring.datasource.url=${DATABASE_URL:jdbc:mariadb://localhost:3306/Khamiar_db}
spring.datasource.username=${DATABASE_USERNAME:Khamiar_user}
spring.datasource.password=${DATABASE_PASSWORD:CHANGE_ME}

# Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.open-in-view=false

# JWT
app.jwt.secret=${JWT_SECRET:CHANGE_ME}
app.jwt.expiry-minutes=480

# CORS
app.cors.allowed-origin=${FRONTEND_URL:http://localhost:5173}
